# --- Required ---
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Pick an Indian-accented voice from the ElevenLabs Voice Library (filter: accent = Indian),
# add it to "My Voices", and paste its voice ID here. The default below is a generic
# premade voice that works out of the box but is NOT Indian-accented.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- Optional tuning ---
GROQ_MODEL=openai/gpt-oss-120b
# SUMMARY_MODEL=            # defaults to GROQ_MODEL

DEEPGRAM_MODEL=nova-3
# en-IN = Indian English. Use "multi" for English + Hindi code-switching (Hinglish).
DEEPGRAM_LANGUAGE=en-IN
# Silence (ms) before Deepgram decides the customer finished a sentence.
# Lower = snappier but may cut people off mid-thought.
STT_ENDPOINTING_MS=350
STT_UTTERANCE_END_MS=1000

ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_SAMPLE_RATE=24000

# Barge-in: customer speech of at least this many words interrupts the agent.
BARGE_IN_MIN_WORDS=2
# Below this average STT confidence the agent asks the customer to repeat.
MIN_CONFIDENCE=0.45
# Agent says "are you still there?" after this many seconds of silence.
IDLE_PROMPT_SECONDS=25
